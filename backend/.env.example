# Copiar a backend/.env y ajustar según haga falta.

# --- Puerto serial del Arduino ---
#
# Acepta tres formas:
#
#  a) Vacío  → el backend auto-detecta el Arduino entre los puertos del host.
#               Solo sirve cuando el backend corre nativo en tu máquina.
#
#  b) Ruta de dispositivo (solo si el proceso ve el USB):
#               SERIAL_PORT=/dev/cu.usbmodem1101         # macOS nativo
#               SERIAL_PORT=/dev/ttyACM0                 # Linux nativo o Docker con devices:
#               SERIAL_PORT=COM3                         # Windows
#
#  c) URL socket (Docker en macOS/Windows: el contenedor NO ve el USB,
#                 así que necesitas un puente TCP corriendo en el host):
#               SERIAL_PORT=socket://host.docker.internal:5555
#
SERIAL_PORT=

BAUD_RATE=9600
ALLOW_ORIGIN=http://localhost:5173
